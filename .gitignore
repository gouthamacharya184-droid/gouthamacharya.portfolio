# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Goutham Portfolio (Vercel Full-Stack)
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets & Environment Variables ─────────────────────────────────────────
# NEVER commit .env files — they contain live API keys and passwords.
# Use .env.example as a safe template instead.
.env
.env.local
.env.*.local
.env.production
.env.development
.vercel
.vercel/

# ── Node Modules ────────────────────────────────────────────────────────────
node_modules/

# ── Build Artifacts ─────────────────────────────────────────────────────────
dist/
build/
.vite/

# ── Logs & Error Files ──────────────────────────────────────────────────────
*.log
*.txt
logs/

# ── Temporary & Scratch Files ───────────────────────────────────────────────
scratch/

# ── OS & Editor Files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.suo
*.user

# ── Coverage & Test Output ──────────────────────────────────────────────────
coverage/
.nyc_output/
