# .env.example — Vercel Full-Stack Portfolio Environment Template
# Set these in Vercel Dashboard → Settings → Environment Variables

# ── Grok / xAI API Key (Server-Side Only) ──────────────────────────────────────
# Get your API key at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# ── Groq API Key (Alternative / Fallback Provider) ────────────────────────────
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── Contact Form Email Delivery (Optional) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
RECIPIENT_EMAIL=gouthamacharya184@gmail.com

# ── Social / Contact Details (Optional Overrides) ──────────────────────────────
WHATSAPP_NUMBER=7619573468
GITHUB_URL=https://github.com/gouthamacharya184-droid
