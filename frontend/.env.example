# frontend/.env.example — Frontend environment template
#
# Copy this to .env.local for local development (it's in .gitignore).
# .env.local is NOT committed to git.
#
# In production (Netlify/Vercel/etc), set VITE_API_BASE_URL to your
# deployed backend URL (e.g., https://api.yourdomain.com).

# ── Backend API URL ────────────────────────────────────────────────────────────
# Leave EMPTY for local dev — Vite proxy handles /api/* automatically.
# Set to your deployed backend URL for production builds.
VITE_API_BASE_URL=

# ── Dev Tunneling ──────────────────────────────────────────────────────────────
# If using ngrok or similar for mobile/demo testing, set your tunnel hostname:
# Example: VITE_ALLOWED_HOST=your-subdomain.ngrok-free.app
VITE_ALLOWED_HOST=
