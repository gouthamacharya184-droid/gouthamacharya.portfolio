# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example — Safe configuration template
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env — it is in .gitignore
#   4. Rotate any credentials immediately if they were ever exposed
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT="8787"
NODE_ENV="development"

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
NGROK_URL=""

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-app-password-here"
RECIPIENT_EMAIL="your-gmail@gmail.com"

# ── Contact Links ─────────────────────────────────────────────────────────────
WHATSAPP_NUMBER="91XXXXXXXXXX"
GITHUB_URL="https://github.com/your-username"

# ── AI / Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key-here"

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-64-byte-random-hex-string"
ADMIN_API_KEY="replace-with-32-byte-random-hex-string"
