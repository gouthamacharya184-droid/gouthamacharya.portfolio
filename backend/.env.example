# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example — Safe configuration template
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env — it is in .gitignore
#   4. Rotate any credentials immediately if they were ever exposed
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example: https://yourdomain.com
# Development example: http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional: extra origin for ngrok tunneling during dev/demo
# Leave blank if not using ngrok.
NGROK_URL=

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your account password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here

# The email address that receives contact form submissions.
RECIPIENT_EMAIL=your-gmail@gmail.com

# ── Contact Links ─────────────────────────────────────────────────────────────
# WhatsApp country code + number (digits only, no + or spaces).
WHATSAPP_NUMBER=91XXXXXXXXXX
# Must start with https://github.com/
GITHUB_URL=https://github.com/your-username

# ── AI / Groq ────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
# ROTATE IMMEDIATELY if this was ever exposed.
GROQ_API_KEY=your-groq-api-key-here

# ── Security ─────────────────────────────────────────────────────────────────
# Strong random secret for JWT signing.
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-random-hex-string

# API key for any internal/admin endpoints (optional).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-32-byte-random-hex-string
